# ==============================================================================
# InkFrame Duo - Environment Configuration
# ==============================================================================

PORT=3000
DATA_DIR=/data

# ------------------------------------------------------------------------------
# Configured E-Paper Frames (1..N Devices)
# Format: comma-separated list of "deviceId:Display Name[:optionalToken]"
# Or set as a JSON array: [{"id":"frame-wife","name":"Wife's Desk Frame"}]
# ------------------------------------------------------------------------------
INKFRAME_DEVICES=frame-wife:Wife's Desk Frame,frame-matt:Matt's Desk Frame

# ------------------------------------------------------------------------------
# Optional Authentication
# Leave blank/commented for zero-friction setup on a trusted home Wi-Fi network.
# ------------------------------------------------------------------------------
# FRAME_TOKEN=               # Global Bearer token required for all frame polls
# WEB_PIN=                   # Optional PIN required to compose/send notes from Web UI
